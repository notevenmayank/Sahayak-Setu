# ---------------------------------------------------------------
# Copy this file to ".env" and fill in the values.
#   Windows:  copy .env.example .env
# ---------------------------------------------------------------

# Port the server listens on. The frontend is served from here too,
# so after starting you open http://localhost:4000
PORT=4000

# Secret used to sign login tokens. Change this to any long random string.
# Anyone who knows this value can forge logins, so never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Groq AI chat assistant (Primary / Recommended) -------------
# Your Groq API key from console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ---- Alternative Providers (Optional) ----------------------------
# If you prefer Grok from console.x.ai:
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# If you prefer Google Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash


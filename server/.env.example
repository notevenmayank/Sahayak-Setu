# ---------------------------------------------------------------
# Copy this file to ".env" and fill in the values.
#   Windows:  copy .env.example .env
# ---------------------------------------------------------------

# Port the server listens on. The frontend is served from here too,
# so after starting you open http://localhost:4000
PORT=4000

# Secret used to sign login tokens. Change this to any long random string.
# Anyone who knows this value can forge logins, so never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string

# ---- AI chat assistant -----------------------------------------
# Your OpenAI API key from https://platform.openai.com/api-keys
# Leave this blank and the chatbox still works using the built-in
# offline fallback brain (rule-based). Add the key to upgrade it.
OPENAI_API_KEY=

# Which model to use. gpt-4o-mini is the cheapest good option.
OPENAI_MODEL=gpt-4o-mini
